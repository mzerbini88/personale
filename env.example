PORT=3000
# Genera con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY_HEX=INSERISCI_64_CARATTERI_ESAdECIMALI
# Indirizzo che riceve una notifica SENZA documenti allegati (opzionale)
NOTIFY_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Crea un valore segreto lungo per accedere all'archivio /admin
ADMIN_TOKEN=CAMBIA_CON_UNA_PASSWORD_LUNGA_CASUALE
# Numero di giorni trascorsi i quali i dati sono eliminati automaticamente
RETENTION_DAYS=7
